{
    "name": "sudippalash/mediauploader",
    "description": "Laravel package for Media Uploader",
    "keywords": [
        "Sudip",
        "Laravel Media Uploader",
        "Media Uploader",
        "Laravel"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sudip Palash",
            "email": "palash.sudip@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "intervention/image": "^3.0",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sudip\\MediaUploader\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sudip\\MediaUploader\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sudip\\MediaUploader\\Providers\\AppServiceProvider",
                "Sudip\\MediaUploader\\Providers\\RouteServiceProvider"
            ],
            "aliases": {
                "MediaUploader": "Sudip\\MediaUploader\\Facades\\MediaUploader"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
